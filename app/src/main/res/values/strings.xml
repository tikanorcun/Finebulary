    <string name="changelog_v2_3_title">Version 2.3 - P2P Course Sharing &amp; Word Duels</string>
    <string name="changelog_v2_3_item_1">Peer-to-Peer Course/Folder Sharing (.finebulary export &amp; import)</string>
    <string name="changelog_v2_3_item_2">Rapid-Fire Vocabulary Duel Mode with challenge score sharing</string>
    <string name="changelog_v2_3_item_3">Interactive Actionable Push Notifications with Quick Action buttons ("I Remember" / "Keep Practicing")</string>
    <string name="changelog_v2_3_item_4">Automatic background update checks on app startup</string>
    <string name="changelog_v2_3_item_5">Interactive in-app feature walkthrough tour &amp; audio pronunciation preview</string>
    <string name="changelog_v2_3_item_6">Complete multi-language localization &amp; AI setup guides</string>

    <!-- Changelog v2.2.1 -->
    <string name="changelog_v2_2_1_title">Hotfix 2.2.1 - Startup Update Check &amp; Localization</string>
    <string name="changelog_v2_2_1_item_1">Added automatic background update check on application startup</string>
    <string name="changelog_v2_2_1_item_2">Completed full multi-language localization (English &amp; Turkish) for API key setup guides and UI elements</string>

    <!-- Changelog v2.2 -->
    <string name="changelog_v2_2_title">Version 2.2 - Folder Management &amp; Interactive Tour</string>
    <string name="changelog_v2_2_item_1">Added duplicate word prevention to avoid adding the same term multiple times in a folder</string>
    <string name="changelog_v2_2_item_2">Added folder view style toggle (switch instantly between Grid and List views)</string>
    <string name="changelog_v2_2_item_3">Added folder renaming support for existing courses and personal folders</string>
    <string name="changelog_v2_2_item_4">Added step-by-step setup guides inside API Keys screen for all AI providers</string>
    <string name="changelog_v2_2_item_5">Added an interactive in-app feature walkthrough tour for first-time users</string>

    <!-- Changelog v2.1 -->
    <string name="changelog_v2_1_title">Version 2.1 - Pronunciation Support &amp; Polish</string>
    <string name="changelog_v2_1_item_1">Added normal and slow (turtle) pronunciation audio buttons directly in the word addition interface</string>
    <string name="changelog_v2_1_item_2">Fixed an issue where clicking "Edit Word" on notification details had no effect</string>

