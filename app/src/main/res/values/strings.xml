    <string name="gemini_guide_2">Click the \'Get API Key\' button in the top left corner.</string>
    <string name="gemini_guide_3">Generate and copy your free API key.</string>
    <string name="groq_guide_1">Go to console.groq.com and create a free account.</string>
    <string name="groq_guide_2">Go to API Keys and click \'Create API Key\'.</string>
